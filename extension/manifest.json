{
  "manifest_version": 3,
  "name": "Product Search Extension",
  "version": "1.0",
  "description": "Search for similar products using image recognition",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
   "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:*;"
  }
}